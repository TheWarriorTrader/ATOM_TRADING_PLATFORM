# ============================================
# CONFIGURAZIONE AMBIENTE - Trading System
# ============================================
# Copiare questo file in .env e modificare i valori
# NON committare .env nel repository!

# ============================================
# CONFIGURATION MANAGEMENT
# ============================================
# Ambiente di esecuzione: development, production, test
APP_ENVIRONMENT=development
# Alternativa: RUN_MODE=development

# ============================================
# APP - Application Metadata (via env vars)
# ============================================
APP_APP__NAME=trading-core
APP_APP__VERSION=0.1.0
# APP_APP__ENVIRONMENT=development  # Override ambiente

# ============================================
# DATABASE (via env vars con prefisso APP_)
# ============================================
# Esempi di override tramite environment variables:
# APP_DATABASE__HOST=localhost
# APP_DATABASE__PORT=5432
# APP_DATABASE__NAME=trading_db
# APP_DATABASE__USER=trader
APP_DATABASE__PASSWORD=dev_password
# APP_DATABASE__MAX_CONNECTIONS=10
# APP_DATABASE__TIMEOUT_MS=5000

# Variabili legacy (usate da alcuni tool)
DATABASE_URL=postgres://trader:dev_password@localhost:5432/trading_db
DB_USER=trader
DB_PASSWORD=dev_password
DB_NAME=trading_db
DB_HOST=localhost
DB_PORT=5432

# ============================================
# REDIS (via env vars con prefisso APP_)
# ============================================
# Esempi di override:
# APP_REDIS__HOST=localhost
# APP_REDIS__PORT=6379
# APP_REDIS__PASSWORD=redis_secret
# APP_REDIS__DB=0
# APP_REDIS__TIMEOUT_MS=2000

# Variabili legacy
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# LOGGING (via env vars con prefisso APP_)
# ============================================
# Livelli: trace, debug, info, warn, error
APP_LOGGING__LEVEL=info
# Formati: json, pretty, compact
APP_LOGGING__FORMAT=pretty
# Output: stdout, stderr, o percorso file
APP_LOGGING__OUTPUT=stdout

# Variabile legacy Rust
RUST_LOG=info
# Abilita backtrace su panic (1 = breve, full = completo)
RUST_BACKTRACE=1

# ============================================
# TRADING (via env vars con prefisso APP_)
# ============================================
APP_TRADING__RISK_ENABLED=true
APP_TRADING__MAX_POSITION_SIZE=100
APP_TRADING__DEFAULT_EXCHANGE=IB
APP_TRADING__PAPER_TRADING=true

# Variabili legacy
TRADING_MODE=paper
MAX_POSITION_VALUE=50000

# ============================================
# SERVER (via env vars con prefisso APP_)
# ============================================
APP_SERVER__HOST=127.0.0.1
APP_SERVER__PORT=8080
APP_SERVER__REQUEST_TIMEOUT_MS=30000

# Variabili legacy
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# INTERACTIVE BROKERS
# ============================================
# TWS (Trading Workstation): porta 7496 (live) o 7497 (paper)
# IB Gateway: porta 4001 (live) o 4002 (paper)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ============================================
# DATABENTO (opzionale)
# ============================================
DATABENTO_API_KEY=your_api_key_here
DATABENTO_DATASET=CME_GLOBEX

# ============================================
# LIMITE PERDITA GIORNALIERA ($)
# ============================================
DAILY_LOSS_LIMIT=5000
